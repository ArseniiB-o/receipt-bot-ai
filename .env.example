# Telegram Bot Token — get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# OpenRouter vision model
# Options: nvidia/nemotron-nano-12b-v2-vl:free, mistralai/mistral-small-3.1-24b-instruct:free, google/gemma-3-27b-it:free
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Google Sheets ID — from the spreadsheet URL: https://docs.google.com/spreadsheets/d/THIS_ID/edit
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Path to Google Service Account JSON file (download from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# Authorized Telegram user IDs, comma-separated (no spaces)
# Find your ID: message @userinfobot on Telegram
# REQUIRED — bot refuses all requests if empty
ALLOWED_USER_IDS=123456789,987654321

# Your Telegram user_id for admin commands like /backup
# Leave empty to disable admin commands
ADMIN_USER_ID=

# GitHub repository URL (used in OpenRouter HTTP-Referer header)
REPO_URL=https://github.com/your-username/receipt-bot

# Folder for storing receipt files
RECEIPTS_FOLDER=./receipts

# SQLite database path
DB_PATH=./receipts.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Ask for confirmation before saving a receipt (true/false)
# true — show Save / Edit / Cancel buttons
# false — save automatically without confirmation
CONFIRMATION_REQUIRED=true
